<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:l="sap.ui.layout"
	xmlns:f="sap.ui.layout.form"
	xmlns:core="sap.ui.core">
    <Dialog >
	<VBox class="sapUiSmallMargin">
		<f:SimpleForm id="SimpleFormChange354"
			editable="true"
			layout="ResponsiveGridLayout"
			title="Purchase Requisition"
			labelSpanXL="3"
			labelSpanL="3"
			labelSpanM="3"
			labelSpanS="12"
			adjustLabelSpan="false"
			emptySpanXL="4"
			emptySpanL="4"
			emptySpanM="4"
			emptySpanS="0"
			columnsXL="1"
			columnsL="1"
			columnsM="1"
			singleContainerFullSize="false" >
			<f:content>
				<Label text="Vendor" >
                    <layoutData>
						<l:GridData span="XL1 L1 M1 S3" />
					</layoutData>
                </Label>
                <HBox >
                 <layoutData>
						<l:GridData span="XL1 L2 M2 S9" />
					</layoutData>
                    <Text id="vendor0" text="{PRItemModel>/PR/0/Vendor}" visible="{= !!${PRItemModel>/edit/0} }"/>
                    <Input id="vendor" value="{PRItemModel>/PR/0/Vendor}" visible="{= !${PRItemModel>/edit/0} }"/>
                </HBox>
				
                 
				
                <Label text="Total Amount" >
                    <layoutData>
						<l:GridData span="XL1 L1 M1 S3" />
					</layoutData>
                </Label>
			<HBox >
                 <layoutData>
						<l:GridData span="XL1 L2 M2 S9" />
					</layoutData>
                    <Text id="amount0" text="{PRItemModel>/PR/0/Total_Amount}" visible="{= !!${PRItemModel>/edit/0} }"/>
                    <Input id="amount" value="{PRItemModel>/PR/0/Total_Amount}" visible="{= !${PRItemModel>/edit/0} }" />
                </HBox>

                
				 <Label text="Requested Date" >
                    <layoutData>
						<l:GridData span="XL1 L1 M1 S3" />
					</layoutData>
                </Label>
				<HBox >
                 <layoutData>
						<l:GridData span="XL1 L2 M2 S9" />
					</layoutData>
                    <Text id="date0" text="{PRItemModel>/PR/0/InvoiceDate}" visible="{= !!${PRItemModel>/edit/0} }" />
                    <Input id="date" value="{PRItemModel>/PR/0/InvoiceDate}" visible="{= !${PRItemModel>/edit/0} }" />
                </HBox>

                 <Table
                    id="idProductsTable"
                    inset="false"
                    headerText="Purchase Requestion Items"
                    items="{
                        path: 'PRItemModel>/PRItem',
                        sorter: { path: 'ItemNumber' }
                    }">
                    <layoutData>
						<l:GridData span="XL12 L12 M12 S12" />
					</layoutData>

                    <columns>
                        <Column id="_IDGenColumn" minScreenWidth="Phone" demandPopin="true" hAlign="Center">
                            <Text id="_IDGenText" text="Item No."/>
                        </Column>
                        <Column id="_IDGenColumn1" minScreenWidth="Phone" demandPopin="true" hAlign="Center">
                            <Text id="_IDGenText1" text="Description"/>
                        </Column>
                        <Column id="_IDGenColumn2" minScreenWidth="Phone" demandPopin="true" hAlign="Center" width="10rem">
                            <Text id="_IDGenText2" text="Quantity"/>
                        </Column>
                        <Column id="_IDGenColumn3" minScreenWidth="Phone" demandPopin="true" hAlign="Center" width="11rem">
                            <Text id="_IDGenText3" text="Price"/>
                        </Column>
                    </columns>

                    <items>
                        <ColumnListItem id="_IDGenColumnListItem" vAlign="Middle">
                            <cells>
                                 <HBox  justifyContent="Center" >
                                    <Text   text="{PRItemModel>ItemNumber}" visible="{= !!${PRItemModel>/edit/0} }"/>
                                     <Input  value="{PRItemModel>ItemNumber}" visible="{= !${PRItemModel>/edit/0} }"/>
                               </HBox>
                               
                                <HBox  justifyContent="Center" >
                                    <Text   text="{PRItemModel>Description}" visible="{= !!${PRItemModel>/edit/0} }"/>
                                     <Input  value="{PRItemModel>Description}" visible="{= !${PRItemModel>/edit/0} }"/>
                               </HBox>

                                <HBox  justifyContent="Center" >
                                    <Text   text="{PRItemModel>Quantity}" visible="{= !!${PRItemModel>/edit/0} }"/>
                                     <Input  value="{PRItemModel>Quantity}" visible="{= !${PRItemModel>/edit/0} }"/>
                               </HBox>

                                <HBox  justifyContent="Center" >
                                    <Text   text="{PRItemModel>Price}" visible="{= !!${PRItemModel>/edit/0} }"/>
                                     <Input  value="{PRItemModel>Price}" visible="{= !${PRItemModel>/edit/0} }"/>
                               </HBox>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
				
			</f:content>
		</f:SimpleForm>
	</VBox>
   	<footer>
			<Toolbar>
				<content>
					
					<ToolbarSpacer />
					<HBox  justifyContent="Center" >
                                    <Button id="editBtn" text="Edit" press="onEditButton" visible="{= !!${PRItemModel>/edit/0} }"/>
                                    <Button id="acceptBtn" icon="sap-icon://accept" press="onAccept" visible="{= !${PRItemModel>/edit/0} }"/>
                                  </HBox>
					<Button id="Reject"
						text="Cancel"
						type="Reject"
						press="._closeDialog"
						ariaHasPopup="Dialog" />

                    <Button id="Accept"
						text="Submit"
						type="Accept"
						press="onconfirm"
						ariaHasPopup="Dialog" />
				</content>
			</Toolbar>
		</footer>
    </Dialog>
</core:FragmentDefinition>