{
  "name": "PurchaseRequisitionPOC",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "dependencies": {
    "@cap-js/hana": "^2",
    "@sap-cloud-sdk/connectivity": "^4",
    "@sap-cloud-sdk/http-client": "^4",
    "@sap-cloud-sdk/resilience": "^4",
    "@sap/cds": "^9",
    "@sap/cds-odata-v2-adapter-proxy": "^1.9.21",
    "express": "^4",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2",
    "@sap/cds-dk": "^9",
    "cds-plugin-ui5": "^0.13.0",
    "mbt": "^1.2.29",
    "rimraf": "^5.0.5"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-purchasereq": "cds watch --open ns.purchasereq/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy PurchaseRequisitionPOC --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1"
  },
  "private": true,
  "cds": {
    "requires": {
      "connectivity": true,
      "destinations": true,
      "html5-repo": true,
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": "db/PurchaseRequisitionPOC.sqlite"
        },
        "schema_evolution":"auto"
      },
      "ZAPI_PURCHASEREQ_PROCESS_SRV": {
        "kind": "odata-v2",
        "model": "srv/external/ZAPI_PURCHASEREQ_PROCESS_SRV",
        "[production]": {
          "credentials": {
            "destination": "hac2build_S09",
            "path": "/sap/opu/odata/sap/API_PURCHASEREQ_PROCESS_SRV"
          }
        },
        "csrf": true,
        "csrfInBatch": true
      },
      "ZAPI_SUPPLIERINVOICE_PROCESS_SRV": {
        "kind": "odata-v2",
        "model": "srv/external/ZAPI_SUPPLIERINVOICE_PROCESS_SRV",
        "[production]": {
          "credentials": {
            "destination": "hac2build_S09",
            "path": "/sap/opu/odata/sap/API_SUPPLIERINVOICE_PROCESS_SRV"
          }
        },
        "csrf": true,
        "csrfInBatch": true
      },
      "Gen_AI": {
        "kind": "rest",
        "credentials": {
          "destination": "SAP-AI-Core-Dest",
          "requestTimeout": 30000,
          "forwardAuthToken": true
        }
      }
    }
  },
  "workspaces": [
    "app/*"
  ]
}